{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "paths": {
      "@shared/*": ["../lib/*"],
      "@/*": ["../*"],
      "@mayor/*": ["../components/mayor/*"],
      "three": ["./node_modules/@types/three"]
    }
  },
  "include": ["src"]
}

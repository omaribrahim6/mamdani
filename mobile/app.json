{
  "expo": {
    "name": "Mamdani",
    "slug": "mamdani",
    "scheme": "mamdani",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mamdani.reporting"
    },
    "android": {
      "package": "com.mamdani.reporting",
      "adaptiveIcon": {
        "backgroundColor": "#26292c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-build-properties",
      [
        "expo-camera",
        {
          "cameraPermission": "Mamdani looks at the problem you point your camera at.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your report needs the spot where the problem is, so the crew can find it."
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "Talk to Mamdani about the problem you’re showing him.",
          "iosBackgroundMode": false,
          "androidPermissions": [
            "android.permission.RECORD_AUDIO"
          ],
          "androidForegroundService": false
        }
      ]
    ]
  }
}

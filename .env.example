# Gemini (AI Studio key) — the analysis brain. Without it the app runs a labelled demo analysis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs — Mamdani's voice. Design a voice in ElevenLabs > Voice Design (see README) and paste its id.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# Tiger Data (Timescale Postgres). Without it the app uses an in-memory store seeded with Ottawa data.
DATABASE_URL=

# City shown to citizens and in the Command Center
NEXT_PUBLIC_CITY=Ottawa

DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=verify-full
# Optional path to your database provider's CA certificate.
DATABASE_SSL_ROOT_CERT=
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-native-audio
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://municipal-api.example.com

# Private report photo bucket; required only for photo submissions.
GCS_BUCKET_NAME=
# Google Application Default Credentials are used by Vertex AI and the photo worker.
# Optional credential file (never commit it):
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json
